{
  "name": "eau-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mon eau du robinet est-elle bonne ? Les analyses officielles de l'eau potable, commune par commune.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data:fetch": "python3 scripts/fetch_data.py",
    "data:prepare": "python3 scripts/prepare_data.py",
    "data:check": "node scripts/check_data.mjs",
    "dev": "astro dev",
    "build": "node scripts/check_data.mjs && astro build && node scripts/postbuild.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "astro": "7.4.8"
  },
  "devDependencies": {
    "@etalab/decoupage-administratif": "^6.0.0"
  }
}
