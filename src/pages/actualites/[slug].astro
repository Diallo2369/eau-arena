---
import Base from "../../layouts/Base.astro";
import { NEWS, INFOS, renderNewsItem, newsJsonLd, seo } from "../../lib/core.js";
import { load } from "../../lib/data.js";
import { SITE_URL } from "../../lib/site.js";
export function getStaticPaths() {
  return [...NEWS, ...INFOS].map((n) => ({ params: { slug: n.slug } }));
}
const { slug } = Astro.params;
const { index, meta } = load();
const s = seo("newsItem", { slug });
---
<Base title={s.title} description={s.desc} page="news" jsonld={newsJsonLd(slug, SITE_URL, meta)}><Fragment set:html={renderNewsItem(slug, index, meta)} /></Base>
