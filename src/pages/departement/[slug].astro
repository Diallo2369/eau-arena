---
import Base from "../../layouts/Base.astro";
import { renderDep, seo, slugify, depOf } from "../../lib/core.js";
import { load } from "../../lib/data.js";
import { SITE_URL } from "../../lib/site.js";
export function getStaticPaths() {
  const { index, depNames } = load();
  const codes = [...new Set(index.map((r) => depOf(r[0])))].filter((c) => depNames[c]);
  return codes.map((code) => ({ params: { slug: slugify(depNames[code], code) }, props: { code, nom: depNames[code] } }));
}
const { code, nom } = Astro.props;
const { index, meta } = load();
const s = seo("dep", { code, nom });
const url = SITE_URL ? SITE_URL + Astro.url.pathname : null;
const jsonld = url ? { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Accueil", item: SITE_URL + "/" }, { "@type": "ListItem", position: 2, name: `${nom} (${code})`, item: url }] } : null;
---
<Base title={s.title} description={s.desc} page="dep" jsonld={jsonld}><Fragment set:html={renderDep(code, nom, index, meta)} /></Base>
