---
import Base from "../layouts/Base.astro";
import { renderHome, seo } from "../lib/core.js";
import { load } from "../lib/data.js";
const { index } = load();
const s = seo("home");
---
<Base title={s.title} description={s.desc} page="home"><Fragment set:html={renderHome(index.filter((r) => r[2]).slice(0, 6))} /></Base>
